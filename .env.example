# ==============================================================================
# Enterprise AI Complaint Classification & Resolution Hub - Configuration
# ==============================================================================

# Core Application Settings
SECRET_KEY=change-in-production-super-secret-jwt-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database with pgvector Extension
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=complaints_db
# Optional full URI override:
DATABASE_URL=

# Vector Search & Semantic Embeddings
VECTOR_DIMENSION=384
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Generative AI: Groq Cloud API
# Get your API key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Generative AI: Local Ollama (Offline Private LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Active AI Provider: "auto", "groq", or "ollama"
AI_PROVIDER=auto

# Gmail API OAuth 2.0 Ingestion
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_COMPLAINTS_LABEL=Complaints

# Service Level Agreement (SLA) Targets in Hours
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=48
