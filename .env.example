# ==============================================================================
# AutoTriage AI - Enterprise Configuration (Example Template)
# ==============================================================================

# Application & Security
PROJECT_NAME="AutoTriage AI - Enterprise Complaint Hub"
VERSION="2.0.0"
SECRET_KEY="super-secret-enterprise-jwt-key-2026-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: PostgreSQL (complaint_db) with SQLite fallback
DATABASE_URL=postgresql+psycopg2://postgres:ranjupriya@localhost:5432/complaint_db
SQLITE_FALLBACK_URL=sqlite:///./autotriage.db

# Vector Search (pgvector / Semantic Embeddings)
VECTOR_DIMENSION=384
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Generative AI: Default Local Ollama (Pluggable LLM Provider)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Cloud Groq Configuration (Optional Provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Email Ingestion: Gmail API (User OAuth 2.0 Credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/emails/callback
GMAIL_COMPLAINTS_LABEL=Complaints

# Service Level Agreement (SLA) Targets in Hours
SLA_HOURS_CRITICAL=2
SLA_HOURS_HIGH=8
SLA_HOURS_MEDIUM=24
SLA_HOURS_LOW=72
